{
  "id": "S22",
  "writes": [
    {
      "method": "PATCH",
      "path": "/rest/v1/store_orders?id=eq.seed-pending-order",
      "body": {
        "status": "cancelled",
        "cancelled_at": "<ts>",
        "updated_at": "<ts>"
      },
      "prefer": "return=minimal",
      "contentType": "application/json"
    },
    {
      "method": "POST",
      "path": "/api/push/notify",
      "body": {
        "customerKey": "store customer",
        "type": "order-cancelled",
        "title": "Order cancelled",
        "body": "Your order was cancelled.",
        "requireInteraction": false,
        "url": "/",
        "tag": "order-cancelled-seed-pending-order"
      }
    }
  ]
}
