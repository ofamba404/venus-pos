{
  "name": "venus-pos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "qa:export": "node scripts/qa-export-quotes.js",
    "qa:score": "node scripts/qa-score-model.js",
    "dev": "vite",
    "build": "vite build && node scripts/copy-legacy.mjs && node scripts/check-legacy-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run && node scripts/check-coverage.mjs && node --experimental-strip-types scripts/check-catalog-sync.mjs",
    "catalog:check": "node --experimental-strip-types scripts/check-catalog-sync.mjs",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:record": "playwright test --project=chromium tests/e2e/contract.spec.ts",
    "lint": "eslint src tests sw --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,js,json,md}\"",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.9",
    "@netlify/functions": "^5.3.0",
    "@preact/signals": "^2.3.2",
    "preact": "^10.27.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^22.19.1",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.39.1",
    "fast-check": "^4.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "serve": "^14.2.5",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
